# =============================================================================
# cora backend — environment variables
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# Server
PORT=4200
NODE_ENV=development

# Database
DB_PATH=./cora.db

# ── SMTP (dashboard login codes) ─────────────────────────────────────────────
# Required for email-OTP login. With NODE_ENV=production a failed send makes
# POST /auth/login return 500 { error: "email_failed" }, so the dashboard shows
# a generic "failed to send code" instead of a login prompt.
#
# Gmail requires a 16-character App Password — NOT your account password:
#   1. Turn on 2-Step Verification for the Google account
#   2. https://myaccount.google.com/apppasswords → create one (e.g. "Cora")
#   3. SMTP_USER = the full @gmail.com address, SMTP_PASS = the app password
#      (Google shows it as "abcd efgh ijkl mnop"; with or without spaces works)
# "535-5.7.8 Username and Password not accepted" means the password is wrong,
# revoked, or 2FA is off — regenerate the App Password and restart the backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com

# Public URL of the Next.js dashboard. Used by the OAuth authorize page to hand
# a signed-in browser back to the dashboard so the connector handshake can
# finish (the backend can only authenticate Bearer headers, not cookies).
# Local: http://localhost:3200 — tunnel: your dashboard's trycloudflare URL.
CORA_DASHBOARD_URL=http://localhost:3200

# Loopback-only session minting for local CLI/dashboard work when SMTP is not
# configured (POST /auth/dev-token). Unreachable from non-loopback IPs, even in
# production. Also used automatically by `cora connector` on localhost.
# CORA_DEV_TOKEN_ENABLED=false

# Stellar — treasury wallet used for USDC/XLM refunds to agents
STELLAR_NETWORK=testnet
STELLAR_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_XLM_SECRET=S...           # Treasury secret key

# Soroban receiver contract — accepts USDC from agents on-chain
RECEIVER_CONTRACT_ID=C...         # Contract ID from `stellar contract deploy` output
# SOROBAN_RPC_URL=                # Optional: override default RPC URL

# VCC fulfillment service — CTX ordering + card scraping.
# Production: https://vcc.ctx.com
# Local testnet: run `node scripts/mock-vcc.mjs` then point here:
VCC_API_BASE=http://127.0.0.1:4300
# Public base URL of this cora instance (VCC callbacks + claim api_url).
# Local: http://localhost:4200 — claim responses become http://localhost:4200/v1
CORA_BASE_URL=http://localhost:4200
# Optional explicit /v1 override for claim responses (defaults to ${CORA_BASE_URL}/v1)
# PUBLIC_API_BASE_URL=http://localhost:4200/v1
# Secret for verifying HMAC-signed callbacks from VCC — generate with: openssl rand -hex 32
VCC_CALLBACK_SECRET=

# CORS — comma-separated allowed origins for the agent API (optional)
# CORS_ORIGINS=https://cora.dev,https://app.cora.dev

# Bootstrap owner — only this email can claim owner role on a fresh instance (optional)
# Leave unset for local dev (first verifier becomes owner)
# OWNER_EMAIL=owner@example.com

# Internal dashboard access — comma-separated emails allowed to access /internal/* routes
# Emails ending in @cora.dev are always allowed regardless of this setting
# INTERNAL_EMAILS=ops@example.com,eng@example.com

# ── MCP ───────────────────────────────────────────────────────────────────────
# Flip to 'true' once a public HTTPS URL is set up (e.g. Cloudflare Tunnel).
# CORA_BASE_URL must already be your tunnel URL before enabling this.
MCP_ENABLED=false
# Max seconds purchase_vcc waits for card fulfillment (default 90s)
# MCP_PURCHASE_WAIT_MS=90000
# Per-IP requests per minute cap for /mcp (default 60)
# MCP_RATE_LIMIT=60

# ── OAuth ─────────────────────────────────────────────────────────────────────
# OAuth 2.0 for the claude.ai connector. Requires MCP_ENABLED=true.
# Flip to 'true' once your Cloudflare Tunnel URL is set as CORA_BASE_URL.
# Then register a client via POST /dashboard/oauth/clients (dashboard API).
OAUTH_ENABLED=false
# Access token TTL in hours (default 1h)
# OAUTH_TOKEN_TTL_HOURS=1
